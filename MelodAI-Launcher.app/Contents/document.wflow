						<key>Name</key>
						<string>AppleScript source:</string>
						<key>Value</key>
						<string>#!/bin/bash
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENGINE_DIR="$REPO_ROOT/acestep-engine"
VENV_DIR="$ENGINE_DIR/venv"
PORT=8000
URL="http://localhost:$PORT"

if [ ! -f "$VENV_DIR/bin/activate" ]; then
    osascript -e 'display dialog "❌ Virtual environment not found.\n\nPlease complete setup first:\n\n1. git clone https://github.com/ace-step/ACE-Step.git /tmp/ace-step\n2. cp -R /tmp/ace-step/. acestep-engine/\n3. cd acestep-engine && python3.11 -m venv venv\n4. source venv/bin/activate\n5. pip install -e . && pip install -r requirements-server.txt" with icon caution buttons {"OK"} default button 1'
    exit 1
fi

cd "$ENGINE_DIR"

if ! curl -s "$URL/health" > /dev/null 2>&1; then
    source "$VENV_DIR/bin/activate"
    nohup uvicorn server:app --port $PORT > /tmp/melodai-server.log 2>&1 &
    
    for i in {1..30}; do
        if curl -s "$URL/health" > /dev/null 2>&1; then
            break
        fi
        sleep 1
    done
fi

open "$URL"
</string>
