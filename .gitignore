# --- Secrets (never commit) ---
.env
*.env
!.env.example

# --- Python ---
venv/
**/venv/
__pycache__/
*.pyc
*.pyo

# --- Node / Next.js ---
node_modules/
.next/
frontend/node_modules/
frontend/.next/

# --- Generated audio output ---
acestep-engine/outputs/
outputs/

# --- Downloaded model checkpoints (pulled at runtime to ~/.cache) ---
**/checkpoints/
*.safetensors
*.ckpt
*.pt

# --- Upstream ACE-Step clone: keep ONLY our own files ---
# The acestep-engine folder is a clone of github.com/ace-step/ACE-Step.
# We only track the files WE added; everything else is ignored.
/acestep-engine/*
!/acestep-engine/server.py
!/acestep-engine/analyze_pitch.py
!/acestep-engine/requirements-server.txt

# --- Abandoned early prototypes (superseded by ACE-Step + MelodAI.html) ---
/backend/
/frontend/

# --- Local tooling / preview config (machine-specific absolute paths) ---
.claude/

# --- OS / editor cruft ---
.DS_Store
*.log
.vscode/
.idea/
